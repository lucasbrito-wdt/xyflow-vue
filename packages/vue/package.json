{
  "name": "@xyflow/vue",
  "version": "0.1.0-alpha.0",
  "description": "Vue Flow - A highly customizable Vue library for building node-based editors, workflow systems, diagrams and more. Official Vue port of xyflow.",
  "keywords": [
    "vue",
    "vue-flow",
    "node-based UI",
    "graph",
    "diagram",
    "workflow",
    "xyflow"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xyflow/xyflow.git",
    "directory": "packages/vue"
  },
  "homepage": "https://xyflow.com",
  "bugs": {
    "url": "https://github.com/xyflow/xyflow/issues"
  },
  "scripts": {
    "dev": "concurrently \"vite build --watch\" pnpm:css-watch",
    "build": "vite build && pnpm css",
    "css": "postcss src/styles/{base,style}.css --config ./../../tooling/postcss-config --dir dist",
    "css-watch": "pnpm css --watch",
    "lint": "eslint ./src",
    "typecheck": "vue-tsc --noEmit"
  },
  "type": "module",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/base.css": "./dist/base.css",
    "./dist/style.css": "./dist/style.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@xyflow/system": "^0.0.76",
    "classcat": "^5.0.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/tsconfig": "^0.5.1",
    "autoprefixer": "^10.4.22",
    "cssnano": "^7.1.2",
    "eslint": "^9.39.1",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-combine-duplicated-selectors": "^10.0.3",
    "postcss-import": "^16.1.1",
    "postcss-nested": "^7.0.2",
    "postcss-rename": "^0.8.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^4.3.0",
    "vue": "^3.5.12",
    "vue-tsc": "^2.1.10"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "files": [
    "dist"
  ]
}
